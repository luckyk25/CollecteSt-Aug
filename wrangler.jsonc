{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collecte-st-aug",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {"crons": ["* * * * *"]},
  "vars": {
    "PUBLIC_ORIGIN": "https://collecte-st-aug.luckyk25.workers.dev",
    "TELEGRAM_BOT_USERNAME": "ma_collecte_vsad_bot",
    "TELEGRAM_ENABLED": "true",
    "TELEGRAM_SCHEDULER_READY": "true",
    "TELEGRAM_TRANSPORT": "webhook",
    "ANONYMOUS_TELEGRAM_LINKS": "true"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "collecte-st-aug",
    "database_id": "e621f93e-7d38-4cfc-95fc-fb304c69e331",
    "migrations_dir": "drizzle"
  }],
  "observability": {"enabled": false}
}
